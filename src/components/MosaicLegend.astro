---
import { getUi, type Locale } from '../i18n/ui';
const { families=[], locale='en' as Locale }=Astro.props;
const s=getUi(locale);
---
<div class="territory-legend sr-only" aria-label={s.colorLegend}>
  {families.map((family:any)=><span class={`legend-item family-${family.id}`}><i aria-hidden="true"></i><span>{family.label}</span></span>)}
</div>

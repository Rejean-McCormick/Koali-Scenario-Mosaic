---
import { getUi, type Locale } from '../i18n/ui';
import { localizeMechanism } from '../i18n/taxonomy';
import { extractScenarioPublicDetails } from '../lib/scenario-public';
import { getScenarioPortal } from '../lib/scenario-portal';
import realCases from '../data/real-cases.json';
const { scenario, locale='en' as Locale }=Astro.props;
const s=getUi(locale);
const details=extractScenarioPublicDetails(scenario.entry.body ?? '',locale);
const portal=getScenarioPortal(scenario.data,scenario.entry.body ?? '',locale);
const mechanisms=(scenario.data.failure_mechanisms ?? []).slice(0,4).map((x:string)=>localizeMechanism(locale,x));
const caseTitles=(scenario.data.real_case_ids ?? []).slice(0,3).map((id:string)=>((realCases as any)[id]?.[locale] ?? id));
---
<section class="scenario-info-mosaic" data-family={scenario.data.problem_family} aria-label={locale==='fr'?'Anatomie du problème et réponse Koali':'Problem anatomy and Koali response'}>
  <article class="detail-hex detail-hex--trigger"><div class="detail-hex-inner"><span>{s.detailWhatBreaks}</span><strong>{mechanisms.join(' · ')}</strong></div></article>
  <article class="detail-hex detail-hex--mechanism"><div class="detail-hex-inner"><span>{s.detailWhoKnows}</span><p>{details.holders.slice(0,3).join(' • ')}</p></div></article>
  <article class="detail-hex detail-hex--flow"><div class="detail-hex-inner"><span>{s.detailKoaliResponse}</span><p>{details.koali}</p></div></article>
  <article class="detail-hex detail-hex--systems"><div class="detail-hex-inner"><span>{s.detailRealCases}</span><ul class="detail-case-list">{caseTitles.map((name:string)=><li>{name}</li>)}</ul></div></article>
  <article class="detail-hex detail-hex--transfer"><div class="detail-hex-inner"><span>{s.detailSuccess}</span><p>{details.success.slice(0,2).join(' • ')}</p></div></article>
</section>
<p class="evidence-note">{s.evidenceNote}</p>

---
import { getUi, type Locale } from '../i18n/ui';
import { getScenarioPortal } from '../lib/scenario-portal';
import { parseScale, localizeScale } from '../lib/scale';
import { scaleVisualLevelFromKey, urgencyVisualLevel, coordinationGapVisualLevel } from '../lib/metric-visuals';
import { localizeScaleValue, localizeUrgency, localizeCoordinationGap, localizeStake, localizeMechanism } from '../i18n/taxonomy';
import { resolveScenarioPreviewImageSet } from '../lib/scenario-image';
const { total=36, locale='en' as Locale, scenario=null }=Astro.props;
const s=getUi(locale);
const selected=Boolean(scenario);
const data=scenario?.data;
const body=scenario?.entry?.body ?? '';
const portal=selected?getScenarioPortal(data,body,locale):null;
const mechanisms=selected?(data.failure_mechanisms ?? []).map((x:string)=>localizeMechanism(locale,x)):[];
const stakes=selected?(data.stakes ?? []).map((x:string)=>localizeStake(locale,x)):[];
const image=selected?resolveScenarioPreviewImageSet(data.id,data.problem_family):null;
const scaleExtent=selected?parseScale(data.scale).extent:'';
const scaleLevel=selected?scaleVisualLevelFromKey(scaleExtent):0;
const urgencyLevel=selected?urgencyVisualLevel(data.urgency):0;
const gapLevel=selected?coordinationGapVisualLevel(data.coordination_gap):0;
const steps=[1,2,3,4];
---
<section class="scenario-preview" data-preview-swipe={!selected?'true':undefined} data-preview-selected={selected?'true':'false'}>
  <div class="preview-image-shell">
    <img data-preview-image data-image-state={selected?'scenario':'cover'} src={selected?image!.src:'/brand/koali-mark.svg'} srcset={selected?image!.srcset:undefined} sizes={selected?image!.sizes:undefined} alt={selected?data.title:'Koali'}/>
  </div>
  <div class="preview-copy">
    <p class="preview-eyebrow"><span data-preview-id>{selected?data.id:(locale==='fr'?'Mosaïque de scénarios Koali':'Koali Scenario Mosaic')}</span><span aria-hidden="true"> · </span><span data-preview-category>{selected?data.problem_family_label:`${total} ${s.examples}`}</span></p>
    <h1 data-preview-title>{selected?data.title:s.exploreWays(total)}</h1>
    <p class="preview-summary" data-preview-summary>{selected?data.hook:s.hoverIntro}</p>
    <div class="preview-metrics-row" data-preview-metrics-row hidden={!selected}>
      <div class="preview-metric" data-preview-scale-wrap>
        <span>{s.scale}</span>
        <div class="preview-metric-visual preview-metric-visual--scale" data-preview-scale-visual data-level={String(scaleLevel)} aria-hidden="true">
          {steps.map((step)=><span class={`metric-scale-ring metric-scale-ring--${step}`} data-step={String(step)}></span>)}
        </div>
        <strong data-preview-scale>{selected?localizeScaleValue(locale,scaleExtent):'—'}</strong>
      </div>
      <div class="preview-metric preview-metric-urgency" data-preview-urgency-wrap data-urgency={selected?data.urgency:undefined}>
        <span>{s.urgency}</span>
        <div class="preview-metric-visual preview-metric-visual--urgency" data-preview-urgency-visual data-level={String(urgencyLevel)} aria-hidden="true">
          {steps.map((step)=><span class={`metric-segment metric-segment--${step}`} data-step={String(step)}></span>)}
        </div>
        <strong data-preview-urgency>{selected?localizeUrgency(locale,data.urgency):'—'}</strong>
      </div>
      <div class="preview-metric preview-metric-gap" data-preview-gap-wrap>
        <span>{s.coordinationGap}</span>
        <div class="preview-metric-visual preview-metric-visual--gap" data-preview-gap-visual data-level={String(gapLevel)} aria-hidden="true">
          {steps.map((step)=><span class={`metric-gap-segment metric-gap-segment--${step}`} data-step={String(step)}></span>)}
        </div>
        <strong data-preview-gap>{selected?localizeCoordinationGap(locale,data.coordination_gap):'—'}</strong>
      </div>
      <div class="preview-metric">
        <span>{s.stakes}</span>
        <strong data-preview-stakes>{selected?stakes.slice(0,3).join(' · '):'—'}</strong>
      </div>
    </div>
    <div class="preview-mechanisms" data-preview-mechanisms>{selected?mechanisms.slice(0,4).map((m:string)=><span>{m}</span>):null}</div>
    <div class="preview-koali" data-preview-koali-wrap hidden={!selected}><span>{s.koaliResponse}</span><p data-preview-koali>{selected?portal!.koaliHelp:''}</p></div>
    {selected?<a class="preview-cta" href={`/${locale}/uses/`}>← {s.detailBack}</a>:<a class="preview-cta touch-full-link" data-preview-link hidden>{s.openExample}<span aria-hidden="true"> →</span></a>}
  </div>
  <aside class="preview-profile" data-preview-profile data-family={selected?data.problem_family:undefined}>
    <div class="profile-heading"><span class="profile-title">{s.insideKoali}</span><span class="profile-section-label">{s.systemPath}</span></div>
    <div class="profile-systems"><div class="system-route-list" data-preview-system-list>
      {selected?portal!.systems.map((system)=><span class="system-route" title={system.description} data-system-key={system.key}><strong>{system.label}</strong><small>{system.description}</small></span>):<span class="system-route-empty">{s.selectSystemHint}</span>}
    </div></div>
    <div class="profile-context">
      <div><span>{s.mechanisms}</span><strong data-preview-mechanism-summary>{selected?mechanisms.slice(0,3).join(' · '):'—'}</strong></div>
      <div><span>{s.scale}</span><strong data-preview-scale-profile>{selected?localizeScale(locale,data.scale):'—'}</strong></div>
    </div>
  </aside>
</section>
<script>
  import '../scripts/preview-layout.ts';
</script>

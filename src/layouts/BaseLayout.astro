---
import '../styles/global.css';
import { getUi, type Locale } from '../i18n/ui';

const {
  locale = 'en' as Locale,
  title = locale === 'fr' ? 'Mosaïque de scénarios Koali' : 'Koali Scenario Mosaic',
  description = locale === 'fr'
    ? 'Explorez 36 problèmes sociotechniques canoniques et la réponse Koali'
    : 'Explore 36 canonical sociotechnical problems and the Koali response',
} = Astro.props;
const strings = getUi(locale);
const alternate: Locale = locale === 'en' ? 'fr' : 'en';
const pathname = Astro.url.pathname;
let alternateHref = pathname.replace(new RegExp(`^/${locale}(?=/|$)`), `/${alternate}`);
if (alternateHref === pathname) alternateHref = `/${alternate}/uses/`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e6864" />
    <link rel="icon" href="/brand/koali-mark.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang={alternate} href={alternateHref} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`/${locale}/uses/`} aria-label={`${strings.scenarioMosaic} — Koali, the Sociotechnical Operating System`}>
        <img class="brand-mark" src="/brand/koali-mark.svg" alt="" width="42" height="19" />
        <span class="brand-copy">
          <span class="brand-product"><strong>Koali</strong><span>{strings.scenarioMosaic}</span></span>
          <small>{strings.brandTagline}</small>
        </span>
      </a>
      <nav class="language-switcher" aria-label={locale === 'fr' ? 'Langue' : 'Language'}>
        <a class:list={[{active: locale === 'en'}]} href={locale === 'en' ? pathname : alternateHref} lang="en" hreflang="en">EN</a>
        <span aria-hidden="true">/</span>
        <a class:list={[{active: locale === 'fr'}]} href={locale === 'fr' ? pathname : alternateHref} lang="fr" hreflang="fr">FR</a>
      </nav>
    </header>
    <main><slot /></main>
  </body>
</html>
